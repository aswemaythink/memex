# Release tokens for memex. Copy to .env (git-ignored) and fill in; never commit .env.
# All three become GitHub Actions secrets (gh secret set -f .env), which the Release workflow publishes with
# (CONTRIBUTING.md, Releases).

# npmjs.com > Access Tokens > Generate New Token > Granular Access Token.
# Packages and scopes: Read and write, scope @aswemaythink (create the npm org "aswemaythink" first).
# Tick "Bypass two-factor authentication" so CI can publish. Expiry: 90 days is fine.
NPM_TOKEN=

# github.com > Settings > Developer settings > Fine-grained tokens > Generate new token.
# Resource owner: aswemaythink. Repository access: Only select repositories > aswemaythink/homebrew-tap.
# Repository permissions: Contents: Read and write (Metadata: Read-only is added automatically).
HOMEBREW_TAP_TOKEN=

# crates.io > Account Settings > API Tokens > New Token (log in with GitHub; verify your email first).
# Scopes: publish-new and publish-update. Crate pattern: agent-memex.
CARGO_REGISTRY_TOKEN=
